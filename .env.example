# ── Required ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ── Google Sheets (required for push_to_sheets.py) ──────────────────
# Path to service account JSON. Default: credentials.json in repo root.
# In CI this is written from the GOOGLE_CREDENTIALS_JSON secret.
GOOGLE_CREDS_FILE=credentials.json

# ── Optional overrides ──────────────────────────────────────────────
# Google Sheet name and tab to push forecast data to
SPREADSHEET_NAME=Marketing Model - Live
WORKSHEET_NAME=Supabase Forecast

# Max age (days) of most recent actuals before push_to_sheets.py aborts.
# Catches stale Looker ingests. Default: 3
MAX_ACTUALS_AGE_DAYS=3

# ── Used by auxiliary scripts (sensible defaults if omitted) ───────
# Tab in the Google Sheet that holds the marketing calendar
# Used by: load_calendar.py
CALENDAR_WORKSHEET_NAME=Calendar

# Tab where the locked/memorialized forecast lives
# Used by: memorialize_forecast.py, reconcile_vintage.py
LOCKED_WORKSHEET_NAME=Locked Forecast

# Tab with the historical archive for backfilling vintages
# Used by: backfill_vintages.py
ARCHIVE_WORKSHEET_NAME=Archive
